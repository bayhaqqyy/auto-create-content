# Kunci API dari Google AI Studio (https://aistudio.google.com/apikey).
# Kosongkan untuk mode demo: naskah contoh dan suara hening, tanpa memanggil API.
GEMINI_API_KEY=

# Model (boleh diganti kalau Google merilis versi baru)
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# Video affiliate (butuh tier berbayar Gemini API)
GEMINI_VIDEO_MODEL=gemini-omni-1.1-flash

# Opsional: path Chrome/Chromium untuk render. Kosongkan agar Remotion mengunduh sendiri.
REMOTION_BROWSER=
